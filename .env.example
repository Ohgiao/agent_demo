# 复制为 .env 后改。变量前缀统一 KB_。

# 必填：把 <你的密码> 换掉。库要先存在（见 README 的 R0）。
KB_POSTGRES_DSN=postgresql://postgres:<你的密码>@127.0.0.1:5432/kb_demo

# 向量表名
KB_COLLECTION_NAME=kb_documents

# Ollama 本机默认端口
KB_OLLAMA_BASE_URL=http://127.0.0.1:11434
KB_CHAT_MODEL=qwen3.5:9b
KB_EMBEDDING_MODEL=bge-m3
# bge-m3 输出 1024 维。改模型必须同步改这里，且重建表（维度不匹配是最常见的启动报错）。
KB_EMBEDDING_DIM=1024

# 切片与召回参数
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_TOP_K=6

KB_UPLOAD_DIR=data/uploads
